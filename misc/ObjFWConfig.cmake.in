execute_process(
	COMMAND sh -c [[
		prefix="@prefix@"
		exec_prefix="@exec_prefix@"
		echo "@bindir@/@BIN_PREFIX@objfw-config"
	]]
	OUTPUT_VARIABLE ObjFW_CONFIG_EXECUTABLE
	OUTPUT_STRIP_TRAILING_WHITESPACE
	RESULT_VARIABLE execute_process_failed
)
if(execute_process_failed)
	message(FATAL_ERROR "Could not determine ObjFW_CONFIG_EXECUTABLE path!")
endif()

macro(objfw_cygpath_to_win32 inpath outpath)
	if(WIN32)
		execute_process(
			COMMAND cygpath -w "${${inpath}}"
			OUTPUT_VARIABLE ${outpath}
			OUTPUT_STRIP_TRAILING_WHITESPACE
			RESULT_VARIABLE execute_process_failed
		)
		if(execute_process_failed)
			message(FATAL_ERROR "cygpath failed!")
		endif()
	endif()
endmacro()

foreach(package ObjFW ${ObjFW_FIND_COMPONENTS})
	if(NOT package STREQUAL "ObjFW")
		set(package_flags "--package;${package}")

		execute_process(
			COMMAND sh ${ObjFW_CONFIG_EXECUTABLE} ${package_flags}
			RESULT_VARIABLE package_not_found
			ERROR_QUIET
		)

		if(package_not_found)
			if(NOT ObjFW_FIND_REQUIRED)
				return()
			endif()

			message(FATAL_ERROR
				"ObjFW package ${package} not found")
		endif()
	else()
		set(package_flags "")
	endif()

	add_library(ObjFW::${package} IMPORTED INTERFACE)
	add_library(ObjFW::${package}-static IMPORTED INTERFACE)

	execute_process(
		COMMAND sh ${ObjFW_CONFIG_EXECUTABLE} --cppflags --objcflags
		${package_flags}
		OUTPUT_VARIABLE compile_options
		OUTPUT_STRIP_TRAILING_WHITESPACE
		RESULT_VARIABLE execute_process_failed
	)
	if(execute_process_failed)
		message(FATAL_ERROR "${ObjFW_CONFIG_EXECUTABLE} failed!")
	endif()
	if(APPLE)
		execute_process(
			COMMAND sh ${ObjFW_CONFIG_EXECUTABLE}
			--framework-libs --ldflags ${package_flags}
			OUTPUT_VARIABLE link_options
			OUTPUT_STRIP_TRAILING_WHITESPACE
			RESULT_VARIABLE execute_process_failed
		)
		if(execute_process_failed)
			message(FATAL_ERROR
				"${ObjFW_CONFIG_EXECUTABLE} failed!")
		endif()
	else()
		execute_process(
			COMMAND sh ${ObjFW_CONFIG_EXECUTABLE} --libs --ldflags
			${package_flags}
			OUTPUT_VARIABLE link_options
			OUTPUT_STRIP_TRAILING_WHITESPACE
			RESULT_VARIABLE execute_process_failed
		)
		if(execute_process_failed)
			message(FATAL_ERROR
				"${ObjFW_CONFIG_EXECUTABLE} failed!")
		endif()
	endif()
	execute_process(
		COMMAND sh ${ObjFW_CONFIG_EXECUTABLE} --static-libs --ldflags
		${package_flags}
		OUTPUT_VARIABLE static_link_options
		OUTPUT_STRIP_TRAILING_WHITESPACE
		RESULT_VARIABLE execute_process_failed
	)
	if(execute_process_failed)
		message(FATAL_ERROR "${ObjFW_CONFIG_EXECUTABLE} failed!")
	endif()

	string(REPLACE " " ";" compile_options "${compile_options}")
	string(REPLACE " " ";" link_options "${link_options}")
	string(REPLACE "-framework;" "-framework "
		link_options "${link_options}")
	string(REPLACE " " ";" static_link_options "${static_link_options}")

	foreach(flag ${compile_options})
		if(flag MATCHES "^-I")
			string(REGEX REPLACE "^-I" "" dir ${flag})
			objfw_cygpath_to_win32(dir dir)
			target_include_directories(ObjFW::${package}
				INTERFACE ${dir})
			target_include_directories(ObjFW::${package}-static
				INTERFACE ${dir})
		elseif(flag MATCHES "^-D")
			target_compile_definitions(ObjFW::${package}
				INTERFACE ${flag})
			target_compile_definitions(ObjFW::${package}-static
				INTERFACE ${flag})
		else()
			target_compile_options(ObjFW::${package} INTERFACE
				$<$<BOOL:$<OBJC_COMPILER_VERSION>>:${flag}>)
			target_compile_options(ObjFW::${package} INTERFACE
				$<$<BOOL:$<OBJCXX_COMPILER_VERSION>>:${flag}>)
			target_compile_options(ObjFW::${package}-static
				INTERFACE
				$<$<BOOL:$<OBJC_COMPILER_VERSION>>:${flag}>)
			target_compile_options(ObjFW::${package}-static
				INTERFACE
				$<$<BOOL:$<OBJCXX_COMPILER_VERSION>>:${flag}>)
		endif()
	endforeach()

	foreach(flag ${link_options})
		if(flag MATCHES "^-l")
			target_link_libraries(ObjFW::${package}
				INTERFACE ${flag})
		elseif(flag MATCHES "^-L")
			string(REGEX REPLACE "^-L" "" dir ${flag})
			objfw_cygpath_to_win32(dir dir)
			target_link_directories(ObjFW::${package}
				INTERFACE ${dir})
		elseif(flag MATCHES "^-framework ")
			target_link_libraries(ObjFW::${package}
				INTERFACE ${flag})
		elseif(flag MATCHES "^-")
			target_link_options(ObjFW::${package}
				INTERFACE ${flag})
		else()
			target_link_libraries(ObjFW::${package}
				INTERFACE ${flag})
		endif()
	endforeach()
	foreach(flag ${static_link_options})
		if(flag MATCHES "^-l")
			target_link_libraries(ObjFW::${package}-static
				INTERFACE ${flag})
		elseif(flag MATCHES "^-L")
			string(REGEX REPLACE "^-L" "" dir ${flag})
			objfw_cygpath_to_win32(dir dir)
			target_link_directories(ObjFW::${package}-static
				INTERFACE ${dir})
		elseif(flag MATCHES "^-framework ")
			target_link_libraries(ObjFW::${package}-static
				INTERFACE ${flag})
		elseif(flag MATCHES "^-")
			target_link_options(ObjFW::${package}-static
				INTERFACE ${flag})
		else()
			target_link_libraries(ObjFW::${package}-static
				INTERFACE ${flag})
		endif()
	endforeach()
endforeach()

add_library(ObjFW::ARC IMPORTED INTERFACE)
execute_process(
	COMMAND sh ${ObjFW_CONFIG_EXECUTABLE} --arc
	OUTPUT_VARIABLE _objfw_arc_options
	OUTPUT_STRIP_TRAILING_WHITESPACE
	RESULT_VARIABLE execute_process_failed
)
if(execute_process_failed)
	message(FATAL_ERROR "${ObjFW_CONFIG_EXECUTABLE} failed!")
endif()
string(REPLACE " " ";" _objfw_arc_options "${_objfw_arc_options}")
foreach(flag ${_objfw_arc_options})
	target_compile_options(ObjFW::ARC INTERFACE ${flag})
endforeach()
